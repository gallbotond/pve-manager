#!/usr/bin/env bash
set -euo pipefail

LIST_SORT=""

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		echo "Usage: list [--sort=id|node|status|name]"
		echo "  -s, --sort=KEY    Sort by KEY (default: id)"
		exit 0
		;;
	--sort=*)
		LIST_SORT="${arg#*=}"
		;;
	-s | --sort)
		LIST_SORT="$2"
		shift
		;;
	esac
done

source "$(dirname "$0")/../lib/_command.sh"

list_vms
